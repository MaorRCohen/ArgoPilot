# Copy to .env. A real environment variable beats this file.
# Local: a SQLite file. A relative path resolves to the services/registry-service folder, whatever the working directory.
DATABASE_URL=sqlite:///registry.db
# Production-style: PostgreSQL as the API's own role (registry_app).
# DATABASE_URL=postgresql+psycopg://registry_app:CHANGE_ME@127.0.0.1:5432/registry
# Setup/seed command and Postgres tests only. The API never reads this.
# DATABASE_OWNER_URL=postgresql+psycopg://registry_owner:CHANGE_ME@127.0.0.1:5432/registry
# Postgres tests only (optional; without it they are skipped). A separate database whose name ends with _test:
# the tests wipe its public schema before every test. Must not be the DATABASE_URL database.
# TEST_DATABASE_URL=postgresql+psycopg://registry_owner:CHANGE_ME@127.0.0.1:5432/registry_test
# Plot photos (S3). Optional: without AWS_S3_BUCKET the photo endpoints answer 503. No credentials here:
# boto3 finds them on the instance (IAM role) or in the standard AWS config.
# AWS_S3_BUCKET=your-photo-bucket
# AWS_REGION=your-bucket-region
