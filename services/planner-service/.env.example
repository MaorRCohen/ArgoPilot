# Copy to .env. A real environment variable beats this file.
# Where the other services live (required).
REGISTRY_URL=http://127.0.0.1:8000
WEATHER_URL=http://127.0.0.1:8001
# Seconds to wait for one answer. The planner never retries: the weather-service is the only retry point.
REGISTRY_TIMEOUT_S=1.0
# A bit above the weather-service's own 4 s budget, so its stale answer arrives before we give up.
WEATHER_TIMEOUT_S=4.5
# Sent in Retry-After on a 503 when the failed service did not send one (seconds).
RETRY_AFTER_S=30
# Extra water for drip non-uniformity: litres = irrigation mm x area x this factor. Never applied to rain.
UNIFORMITY_FACTOR=1.1
# Longest run per day (minutes). A bigger refill is cut to fit and the rest carries to the next day.
MAX_RUN_MINUTES_PER_DAY=1440
# Crop values (Kc, height, stage lengths). Default: crop_profiles.json next to config.py.
# CROP_PROFILES_PATH=crop_profiles.json
