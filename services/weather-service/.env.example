# Copy to .env. A real environment variable beats this file.
# Open-Meteo free tier. Paid plan: the customer endpoint (customer-api.open-meteo.com, same path) plus OPEN_METEO_API_KEY.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Empty = free tier: no key is sent.
OPEN_METEO_API_KEY=
# One attempt waits at most this long (seconds).
PROVIDER_TIMEOUT_S=1.5
# Retries after the first attempt: 2 means 3 attempts.
PROVIDER_RETRIES=2
# Retry number n (0, 1, ...) waits a random time between 0 and BACKOFF_BASE_S * 2**n seconds.
BACKOFF_BASE_S=0.2
# All attempts and waits together (seconds). A caller waits at most this long for one forecast.
PROVIDER_TOTAL_BUDGET_S=4
# A forecast younger than this is served without calling the provider (3 hours).
FRESH_FOR_S=10800
# The oldest forecast served as stale when the provider fails (24 hours).
MAX_STALE_S=86400
# After a cell failed (all retries), the provider is not called for it again for this long (seconds).
FAILURE_COOLDOWN_S=30
# Grid cells kept in memory. The least recently requested cell is dropped first.
CACHE_MAX_CELLS=10000
# Days asked from the provider on every fetch. 8 = today + 7, so a 24 hour old forecast still covers 7 days.
FORECAST_FETCH_DAYS=8
